MODULE ASP; (* Parser of the 65xx assembler.

   Port of as/src/parser.c, shaped after the Oberon compiler's ORP: a
   recursive descent parser with one symbol of lookahead in sym. It
   translates the source into operations of the interpreter (ASI).

   The source is a sequence of statements, one to a line:

     statement  = [label] [instruction | directive | macrocall]
                | [VAR | LET] identdef "=" expression
                | ident op"=" expression
                | ident MACRO [ident {"," ident}] "{" block "}"
                | IF expression "{" block "}"
                    {ELSE IF expression "{" block "}"} [ELSE "{" block "}"]
                | "{" block "}"
                | ".proc" ident ["(" [VAR] type {"," [VAR] type} ")"] [":" type]
                | ".type" ident "=" type
                | END.
     label      = identdef.
     identdef   = ["."] ident ["*"] [":"].
     block      = {statement}.
     expression = simple [relation simple].
     simple     = ["+" | "-"] term {("+" | "-" | "|" | "||") term}.
     term       = factor {("*" | "/" | DIV | MOD | "&" | "&&") factor}.
     factor     = number | string | ["."] ident {"." ident} | "(" expression ")"
                | ("!" | "~" | "-" | "+" | "<" | ">" | "^") factor.

   A "." before a name makes it local to the label last defined, and "*"
   after a name exports it. A label may be spelled like a mnemonic, a
   directive, DIV or MOD if "*" or ":" follows it. As prefix operators "<", ">" and "^" select
   the low, high and bank byte of a value. *)

  IMPORT ASH, ASC, ASS, ASB, ASG, ASI;

  CONST maxParams = 16;   (* of a macro *)

  VAR sym: INTEGER;       (* the symbol last read *)
    ended: BOOLEAN;       (* an END statement was read *)
    included: BOOLEAN;    (* the statement just read switched to an include file *)
    outName: ASH.Path;    (* symbol files are looked for beside the output *)
    expression: PROCEDURE (local: BOOLEAN);   (* to avoid a forward reference *)
    statement: PROCEDURE;

  (* --- symbols --- *)

  (* Read the next symbol. When that leaves a line behind, the text of
     the line is handed to the listing: every operation of the line has
     been generated by now. *)
  PROCEDURE Get;
  BEGIN
    IF (sym = ASS.eol) & (ASS.listSrc # NIL) & ASS.listSrc.isFile THEN
      ASI.Line(ASS.listSrc, ASS.listFrom, ASS.listTo)
    END;
    ASS.Get(sym)
  END Get;

  PROCEDURE AtEnd(): BOOLEAN;   (* of a statement *)
  BEGIN RETURN (sym = ASS.eol) OR (sym = ASS.eot) OR (sym = ASS.rbrace)
  END AtEnd;

  (* Skip the rest of a line that makes no sense, so that one mistake
     gives one message. *)
  PROCEDURE Skip;
  BEGIN
    WHILE (sym # ASS.eol) & (sym # ASS.eot) DO Get END
  END Skip;

  PROCEDURE Unexpected;
    VAR s: ARRAY 40 OF CHAR;
  BEGIN ASS.SymName(sym, s); ASS.MarkS("unexpected ", s); Skip
  END Unexpected;

  PROCEDURE Check(s: INTEGER; msg: ARRAY OF CHAR);
  BEGIN
    IF sym = s THEN Get ELSE ASS.Mark(msg) END
  END Check;

  (* sym is an identifier or a reserved word; ASS.id holds its spelling *)
  PROCEDURE IsWord(): BOOLEAN;
  BEGIN RETURN (sym = ASS.ident) OR (sym >= ASS.regA) OR (sym = ASS.div) OR (sym = ASS.mod)
  END IsWord;

  (* A name is expected. After a "." any word will do, so that a local
     label or an export may be spelled like a mnemonic or directive. *)
  PROCEDURE IsName(anyWord: BOOLEAN): BOOLEAN;
  BEGIN RETURN (sym = ASS.ident) OR (sym = ASS.end) OR anyWord & IsWord()
  END IsName;

  (* --- expressions --- *)

  (* ident {"." ident}; local: the name follows a "." *)
  PROCEDURE Designator(local: BOOLEAN);
    VAR ref, last, sub: ASI.Ref;
  BEGIN ref := ASI.NewRef(ASS.id); ref.local := local; last := ref;
    Get;
    WHILE ~local & (sym = ASS.period) DO
      Get;
      IF IsName(TRUE) THEN
        sub := ASI.NewRef(ASS.id); last.sub := sub; last := sub; Get
      ELSE ASS.Mark("identifier expected")
      END
    END;
    ASI.PutRef(ASI.pushVar, ref)
  END Designator;

  PROCEDURE Factor(local: BOOLEAN);
  BEGIN
    IF sym = ASS.int THEN ASI.PushInt(ASS.ival); Get
    ELSIF sym = ASS.real THEN ASI.PushReal(ASS.rval); Get
    ELSIF sym = ASS.string THEN ASI.PushStr(ASS.str, ASS.slen); Get
    ELSIF sym = ASS.period THEN Get;
      IF IsName(TRUE) THEN Designator(TRUE)
      ELSE ASS.Mark("identifier expected"); ASI.PushInt(0)
      END
    ELSIF IsName(local) THEN Designator(local)
    ELSIF sym = ASS.lparen THEN Get; expression(FALSE); Check(ASS.rparen, ") expected")
    ELSIF sym = ASS.not THEN Get; Factor(FALSE); ASI.Put(ASI.not)
    ELSIF sym = ASS.tilde THEN Get; Factor(FALSE); ASI.Put(ASI.cpl)
    ELSIF sym = ASS.minus THEN Get; Factor(FALSE); ASI.Put(ASI.neg)
    ELSIF sym = ASS.plus THEN Get; Factor(FALSE)
    ELSIF sym = ASS.lss THEN Get; Factor(FALSE); ASI.Put(ASI.low)
    ELSIF sym = ASS.gtr THEN Get; Factor(FALSE); ASI.Put(ASI.high)
    ELSIF sym = ASS.caret THEN Get; Factor(FALSE); ASI.Put(ASI.bank)
    ELSE ASS.Mark("expression expected"); ASI.PushInt(0);
      IF ~AtEnd() THEN Get END
    END
  END Factor;

  (* the operation of a binary operator symbol, -1 if s is none *)
  PROCEDURE Operation(s: INTEGER): INTEGER;
    VAR op: INTEGER;
  BEGIN
    CASE s OF
      ASS.times: op := ASI.mul | ASS.slash, ASS.div: op := ASI.div
    | ASS.mod: op := ASI.mod | ASS.and: op := ASI.and | ASS.land: op := ASI.land
    | ASS.plus: op := ASI.add | ASS.minus: op := ASI.sub
    | ASS.bar: op := ASI.or | ASS.lor: op := ASI.lor
    | ASS.eql: op := ASI.eql | ASS.neq: op := ASI.neq | ASS.lss: op := ASI.lss
    | ASS.leq: op := ASI.leq | ASS.gtr: op := ASI.gtr | ASS.geq: op := ASI.geq
    | ASS.lshift: op := ASI.shl | ASS.rshift: op := ASI.shr
    END;
    RETURN op
  END Operation;

  PROCEDURE Term(local: BOOLEAN);
    VAR op: INTEGER;
  BEGIN Factor(local);
    WHILE (sym >= ASS.times) & (sym <= ASS.land) DO
      op := Operation(sym); Get; Factor(FALSE); ASI.Put(op)
    END
  END Term;

  PROCEDURE SimpleExpression(local: BOOLEAN);
    VAR op: INTEGER;
  BEGIN
    IF sym = ASS.minus THEN Get; Term(local); ASI.Put(ASI.neg)
    ELSIF sym = ASS.plus THEN Get; Term(local)
    ELSE Term(local)
    END;
    WHILE (sym >= ASS.plus) & (sym <= ASS.lor) DO
      op := Operation(sym); Get; Term(FALSE); ASI.Put(op)
    END
  END SimpleExpression;

  (* local: the first name of the expression follows a "." that has
     been read already *)
  PROCEDURE Expression(local: BOOLEAN);
    VAR op: INTEGER;
  BEGIN SimpleExpression(local);
    IF (sym >= ASS.eql) & (sym <= ASS.rshift) THEN
      op := Operation(sym); Get; SimpleExpression(FALSE); ASI.Put(op)
    END
  END Expression;

  (* [expression {"," expression}] up to the end of the statement; the
     result is the number of expressions *)
  PROCEDURE List(): INTEGER;
    VAR n: INTEGER;
  BEGIN n := 0;
    IF ~AtEnd() THEN
      Expression(FALSE); n := 1;
      WHILE sym = ASS.comma DO Get; Expression(FALSE); INC(n) END
    END;
    RETURN n
  END List;

  (* --- instructions --- *)

  (* the operand size modifier a letter stands for, MNone if it is none *)
  PROCEDURE Modifier(ch: CHAR; float: BOOLEAN): INTEGER;
    VAR m: INTEGER;
  BEGIN ch := ASH.Cap(ch);
    IF ch = "B" THEN m := ASG.MByte
    ELSIF ch = "D" THEN m := ASG.MDirect
    ELSIF ch = "W" THEN m := ASG.MWord
    ELSIF ch = "A" THEN m := ASG.MAbs
    ELSIF ch = "L" THEN m := ASG.MLong
    ELSIF float & (ch = "F") THEN m := ASG.MFloat
    ELSE m := ASG.MNone
    END;
    RETURN m
  END Modifier;

  (* the operand after "(" or "[": an indirect addressing mode *)
  PROCEDURE Indirect(VAR mode: INTEGER);
    VAR long: BOOLEAN; close: INTEGER;
  BEGIN long := sym = ASS.lbrak;
    IF long THEN close := ASS.rbrak ELSE close := ASS.rparen END;
    Get; Expression(FALSE);
    IF sym = close THEN Get;
      IF sym = ASS.comma THEN Get;
        IF sym = ASS.regY THEN Get;
          IF long THEN mode := ASC.mDPIndLY ELSE mode := ASC.mDPIndY END
        ELSIF sym = ASS.regX THEN Get; mode := ASC.mDPIndX
        ELSE ASS.Mark("X or Y expected")
        END
      ELSIF long THEN mode := ASC.mAbsIndL
      ELSE mode := ASC.mAbsInd
      END
    ELSIF sym = ASS.comma THEN Get;
      IF sym = ASS.regX THEN Get; Check(close, "bracket expected"); mode := ASC.mAbsIndX
      ELSIF sym = ASS.regS THEN Get;
        Check(ASS.rparen, ") expected"); Check(ASS.comma, ", expected");
        Check(ASS.regY, "Y expected"); mode := ASC.mSRIY
      ELSE ASS.Mark("X or S expected")
      END
    ELSE ASS.Mark("bracket expected")
    END
  END Indirect;

  (* The operands of an instruction, its mnemonic read. *)
  PROCEDURE Operands(mnemonic: INTEGER);
    VAR mode, modifier: INTEGER; local: BOOLEAN;
  BEGIN modifier := ASG.MNone; local := FALSE;
    mode := ASC.mImpl;
    IF sym = ASS.period THEN  (*a modifier, or the "." of a local label*)
      Get;
      IF IsWord() & (ASS.id[1] = 0X) THEN modifier := Modifier(ASS.id[0], FALSE) END;
      IF modifier # ASG.MNone THEN Get ELSE local := TRUE END
    END;
    IF sym = ASS.hash THEN Get; Expression(FALSE);
      IF sym = ASS.comma THEN Get;
        IF sym = ASS.hash THEN Get END;
        Expression(FALSE); mode := ASC.mPair
      ELSE mode := ASC.mImm
      END
    ELSIF (sym = ASS.regA) & ~local THEN Get; mode := ASC.mAcc
    ELSIF AtEnd() & ~local THEN mode := ASC.mImpl
    ELSIF ((sym = ASS.lparen) OR (sym = ASS.lbrak)) & ~local THEN Indirect(mode)
    ELSE Expression(local);
      IF sym = ASS.comma THEN Get;
        IF sym = ASS.regX THEN Get; mode := ASC.mAbsX
        ELSIF sym = ASS.regY THEN Get; mode := ASC.mAbsY
        ELSIF sym = ASS.regS THEN Get; mode := ASC.mSR
        ELSE Expression(FALSE);
          IF sym = ASS.comma THEN Get; Expression(FALSE); mode := ASC.mTriple
          ELSE mode := ASC.mPair
          END
        END
      ELSE mode := ASC.mAbs
      END
    END;
    ASI.Instr(mnemonic, mode, modifier)
  END Operands;

  PROCEDURE Instruction;
    VAR mnemonic: INTEGER;
  BEGIN mnemonic := sym - ASS.instr; Get; Operands(mnemonic)
  END Instruction;

  (* --- directives --- *)

  PROCEDURE Include;
    VAR path: ASH.Path;
  BEGIN
    IF sym # ASS.string THEN ASS.Mark("file name expected"); Skip
    ELSE ASH.Copy(ASS.str, path); Get;
      IF sym # ASS.eol THEN ASS.Mark("end of line expected"); Skip
      ELSE
        (* The included text takes the place of the line end, which the
           scanner has read already: list the line before switching. *)
        ASI.Line(ASS.listSrc, ASS.listFrom, ASS.listTo);
        IF ~ASS.Include(path) THEN ASS.MarkS("cannot read include file ", path) END;
        ASS.Get(sym); included := TRUE
      END
    END
  END Include;

  (* SECTION name [, type [, flags]] *)
  PROCEDURE Section;
    VAR name: ASS.Ident; type, flags: INTEGER;
  BEGIN type := ASG.Progbits; flags := ASG.Exec;
    IF sym # ASS.string THEN ASS.Mark("section name expected"); Skip
    ELSE ASH.Copy(ASS.str, name); Get;
      IF sym = ASS.comma THEN Get;
        IF sym = ASS.int THEN type := ASS.ival; Get ELSE ASS.Mark("number expected") END
      END;
      IF sym = ASS.comma THEN Get;
        IF sym = ASS.int THEN flags := ASS.ival; Get ELSE ASS.Mark("number expected") END
      END;
      ASI.SetSection(name, type, flags)
    END
  END Section;

  (* The rest of a directive, its keyword dir read. *)
  PROCEDURE DirectiveRest(dir: INTEGER);
    VAR modifier, n: INTEGER;
  BEGIN modifier := ASG.MNone;
    IF sym = ASS.period THEN Get;
      IF (sym = ASS.int) & (ASS.ival = 0) THEN modifier := ASG.MZero
      ELSIF (sym = ASS.int) & (ASS.ival = 7) THEN modifier := ASG.MBit7
      ELSIF IsWord() & (ASS.id[1] = 0X) THEN modifier := Modifier(ASS.id[0], TRUE)
      END;
      IF modifier = ASG.MNone THEN ASS.Mark("unknown modifier") END;
      Get
    END;
    IF dir = ASS.include THEN Include
    ELSIF dir = ASS.import THEN
      IF IsName(TRUE) THEN ASB.ImportModule(ASS.id, outName); Get
      ELSE ASS.Mark("module name expected")
      END
    ELSIF dir = ASS.section THEN Section
    ELSIF (dir = ASS.data) OR (dir = ASS.byte) OR (dir = ASS.word) OR (dir = ASS.long) OR
          (dir = ASS.float) THEN
      IF (dir = ASS.word) OR (dir = ASS.data) & ((modifier = ASG.MWord) OR (modifier = ASG.MAbs)) THEN
        dir := ASI.word
      ELSIF (dir = ASS.long) OR (dir = ASS.data) & (modifier = ASG.MLong) THEN dir := ASI.long
      ELSIF (dir = ASS.float) OR (dir = ASS.data) & (modifier = ASG.MFloat) THEN dir := ASI.float
      ELSE dir := ASI.byte
      END;
      n := List();
      IF n > 0 THEN ASI.PutN(dir, n, modifier) END
    ELSIF dir = ASS.text THEN n := List();
      IF n > 0 THEN ASI.PutN(ASI.text, n, modifier) END
    ELSIF dir = ASS.fill THEN n := List();
      IF n > 0 THEN ASI.PutN(ASI.fill, n, modifier) ELSE ASS.Mark("length expected") END
    ELSIF dir = ASS.align THEN Expression(FALSE); ASI.Put(ASI.align)
    ELSIF dir = ASS.message THEN n := List(); ASI.PutN(ASI.message, n, 0)
    ELSIF dir = ASS.error THEN n := List(); ASI.PutN(ASI.error, n, 0)
    ELSIF dir = ASS.errorif THEN  (* ERRORIF condition, text ... *)
      Expression(FALSE); Check(ASS.comma, ", expected");
      n := List(); ASI.PutN(ASI.errorIf, n, 0)
    ELSIF dir = ASS.title THEN Expression(FALSE); ASI.Put(ASI.title)
    ELSIF dir = ASS.subheading THEN Expression(FALSE); ASI.Put(ASI.subheading)
    ELSIF dir = ASS.page THEN ASI.Put(ASI.page)
    ELSIF dir = ASS.double THEN ASS.Mark("double precision is not supported"); Skip
    ELSE ASS.Mark("directive not implemented"); Skip
    END
  END DirectiveRest;

  PROCEDURE Directive;
    VAR dir: INTEGER;
  BEGIN dir := sym; Get; DirectiveRest(dir)
  END Directive;

  (* --- macros --- *)

  (* name MACRO [ident {"," ident}] "{" block "}"; MACRO has been read *)
  PROCEDURE MacroDefinition(name: ARRAY OF CHAR);
    VAR m: ASI.Macro; n: INTEGER; ref: ASI.Ref;
      params: ARRAY maxParams OF ASI.Ref;
  BEGIN
    IF ASI.InMacro() THEN ASS.Mark("a macro cannot be defined inside a macro"); Skip
    ELSE
      IF ASI.ThisMacro(name) # NIL THEN ASS.MarkS("macro defined twice: ", name) END;
      m := ASI.BeginMacro(name); n := 0;
      WHILE IsName(FALSE) DO
        IF n < maxParams THEN params[n] := ASI.NewRef(ASS.id); INC(n)
        ELSE ASS.Mark("too many parameters")
        END;
        Get;
        IF sym = ASS.comma THEN Get END
      END;
      ASI.SetParams(m, n);
      (* a call pushes the arguments in order, so the body starts by
         popping them into the parameters, last one first *)
      WHILE n > 0 DO DEC(n); ref := params[n]; ASI.PutRef(ASI.defVar, ref) END;
      IF sym = ASS.lbrace THEN Get;
        WHILE (sym # ASS.rbrace) & (sym # ASS.eot) DO statement END;
        Check(ASS.rbrace, "} expected")
      ELSE ASS.Mark("{ expected"); Skip
      END;
      ASI.EndMacro
    END
  END MacroDefinition;

  PROCEDURE MacroCall(m: ASI.Macro);
    VAR n: INTEGER;
  BEGIN Get; n := List();
    IF n # m.nofpar THEN ASS.MarkS("wrong number of arguments for macro ", m.name)
    ELSE ASI.Call(m)
    END
  END MacroCall;

  (* --- statements --- *)

  (* --- Oberon types and signatures --- *)

  PROCEDURE SkipEols;
  BEGIN
    WHILE sym = ASS.eol DO Get END
  END SkipEols;

  (* type = qualident | ARRAY [length] OF type | RECORD fields END
       | PROCEDURE formals
     fields = [fieldlist {("," | eol) fieldlist}]
     fieldlist = ident {"," ident} ":" type
     formals = ["(" [[VAR] type {"," [VAR] type}] ")"] [":" type]
     An array without a length is open, for a parameter only; a record
     may run over several lines. INTEGER, LONGINT, REAL and the other
     basic types are predeclared; others are declared with ".type".
     With formals, the formals of a procedure type, PROCEDURE read. *)
  PROCEDURE TypeSpec(open, formals: BOOLEAN): ASB.Type;
    VAR t, ft: ASB.Type; names: ARRAY 16 OF ASS.Ident; n, i, len: INTEGER; var: BOOLEAN;
  BEGIN t := NIL;
    IF formals THEN t := ASB.NewProcType();
      IF sym = ASS.lparen THEN Get;
        WHILE (sym # ASS.rparen) & ~AtEnd() DO
          var := sym = ASS.var;
          IF var THEN Get END;
          ft := TypeSpec(TRUE, FALSE);
          IF ft # NIL THEN
            IF t.sig.nofpar < ASB.maxPar THEN
              t.sig.partype[t.sig.nofpar] := ft; t.sig.parvar[t.sig.nofpar] := var; INC(t.sig.nofpar)
            ELSE ASS.Mark("too many parameters")
            END
          END;
          IF sym = ASS.comma THEN Get END
        END;
        Check(ASS.rparen, ") expected")
      END;
      IF sym = ASS.colon THEN Get; t.sig.restype := TypeSpec(FALSE, FALSE) END
    ELSIF IsName(TRUE) & ASH.Same(ASS.id, "PROCEDURE") THEN Get; t := TypeSpec(FALSE, TRUE)
    ELSIF IsName(TRUE) & ASH.Same(ASS.id, "ARRAY") THEN Get; len := -1;
      IF sym = ASS.int THEN len := ASS.ival; Get
      ELSIF ~open THEN ASS.Mark("array length expected")
      END;
      IF IsName(TRUE) & ASH.Same(ASS.id, "OF") THEN Get ELSE ASS.Mark("OF expected") END;
      ft := TypeSpec(FALSE, FALSE);
      IF ft # NIL THEN
        IF len < 0 THEN t := ASB.NewType(ASB.Array, 6)   (*pointer and length*)
        ELSE t := ASB.NewType(ASB.Array, len * ft.size)
        END;
        t.len := len; t.base := ft
      END
    ELSIF IsName(TRUE) & ASH.Same(ASS.id, "RECORD") THEN Get; SkipEols;
      t := ASB.NewType(ASB.Record, 0);
      WHILE IsName(FALSE) & (sym # ASS.end) DO
        n := 0;
        WHILE IsName(FALSE) & (sym # ASS.end) DO
          IF n < LEN(names) THEN ASH.Copy(ASS.id, names[n]); INC(n) ELSE ASS.Mark("too many fields") END;
          Get;
          IF sym = ASS.comma THEN Get END
        END;
        Check(ASS.colon, ": expected");
        ft := TypeSpec(FALSE, FALSE);
        IF ft # NIL THEN
          FOR i := 0 TO n - 1 DO ASB.AddField(t, names[i], ft) END
        END;
        IF sym = ASS.comma THEN Get END;
        SkipEols
      END;
      IF sym = ASS.end THEN Get ELSE ASS.Mark("END expected") END
    ELSIF IsName(TRUE) THEN t := ASB.ThisType(ASS.id);
      IF t = NIL THEN ASS.MarkS("unknown type: ", ASS.id) END;
      Get
    ELSE ASS.Mark("type expected");
      IF ~AtEnd() THEN Get END
    END;
    RETURN t
  END TypeSpec;

  (* ".type" ident "=" type declares an Oberon type for the symbol file. *)
  PROCEDURE TypeDeclaration;
    VAR name: ASS.Ident; t: ASB.Type;
  BEGIN
    IF ~IsName(TRUE) THEN ASS.Mark("type name expected"); Skip
    ELSIF ASB.ThisType(ASS.id) # NIL THEN ASS.MarkS("type declared twice: ", ASS.id); Skip
    ELSE ASH.Copy(ASS.id, name); Get;
      IF sym = ASS.times THEN Get END;
      Check(ASS.becomes, "= expected");
      t := TypeSpec(FALSE, FALSE);
      IF t # NIL THEN
        IF t.name[0] # 0X THEN ASS.MarkS("a new type expected: ", t.name)
        ELSE ASB.DeclareType(t, name)
        END
      END
    END
  END TypeDeclaration;

  (* ".proc" name formals declares the Oberon signature of an exported
     procedure. *)
  PROCEDURE Signature;
    VAR name: ASS.Ident; t: ASB.Type;
  BEGIN
    IF ~IsName(TRUE) THEN ASS.Mark("procedure name expected"); Skip
    ELSE ASH.Copy(ASS.id, name); Get; t := TypeSpec(FALSE, TRUE); ASB.AddSignature(name, t.sig)
    END
  END Signature;

  (* The rest of identdef, the name having been read: ["*"] [":"] *)
  PROCEDURE DefMarks(ref: ASI.Ref);
  BEGIN
    IF sym = ASS.times THEN ref.expo := TRUE; Get END;
    IF sym = ASS.colon THEN Get END
  END DefMarks;

  (* identdef "=" expression, for VAR and LET and for definitions on
     the command line *)
  PROCEDURE Definition(constant, optional: BOOLEAN);
    VAR ref: ASI.Ref;
  BEGIN
    IF ~IsName(FALSE) THEN ASS.Mark("identifier expected"); Skip
    ELSE ref := ASI.NewRef(ASS.id); ref.rdo := constant; Get; DefMarks(ref);
      IF sym = ASS.becomes THEN Get; Expression(FALSE); ASI.PutRef(ASI.defVar, ref)
      ELSIF optional THEN ASI.PushInt(1); ASI.PutRef(ASI.defVar, ref)
      ELSE ASS.Mark("= expected"); Skip
      END
    END
  END Definition;

  (* IF expression "{" block "}" {ELSE IF expression "{" block "}"}
     [ELSE "{" block "}"]; ELSE follows its "}" on the same line. *)
  PROCEDURE IfStatement;
    VAR done: BOOLEAN;

    PROCEDURE Branch;
    BEGIN Get;
      WHILE (sym # ASS.rbrace) & (sym # ASS.eot) & ~ended DO statement END;
      Check(ASS.rbrace, "} expected")
    END Branch;

  BEGIN Get; Expression(FALSE);
    IF sym # ASS.lbrace THEN ASS.Mark("{ expected"); Skip
    ELSE ASI.Put(ASI.ifBegin); Branch; done := FALSE;
      WHILE (sym = ASS.else) & ~done DO Get;
        IF sym = ASS.if THEN ASI.Put(ASI.elseCond); Get; Expression(FALSE);
          ASI.Put(ASI.elseIf);
          IF sym = ASS.lbrace THEN Branch ELSE ASS.Mark("{ expected"); Skip; done := TRUE END
        ELSIF sym = ASS.lbrace THEN ASI.Put(ASI.else); Branch; done := TRUE
        ELSE ASS.Mark("{ expected"); Skip; done := TRUE
        END
      END;
      ASI.Put(ASI.endIf)
    END
  END IfStatement;

  (* A statement that begins with the name in ref: an assignment, a
     macro definition, or a label and what follows it. *)
  PROCEDURE Named(ref: ASI.Ref);
    VAR op: INTEGER; m: ASI.Macro;
  BEGIN DefMarks(ref);
    IF sym = ASS.becomes THEN Get; Expression(FALSE); ASI.PutRef(ASI.popVar, ref)
    ELSIF sym = ASS.opbecomes THEN
      op := Operation(ASS.op); ASI.PutRef(ASI.pushVar, ref);
      Get; Expression(FALSE); ASI.Put(op); ASI.PutRef(ASI.popVar, ref)
    ELSIF sym = ASS.macro THEN Get; MacroDefinition(ref.name)
    ELSE ASI.PutRef(ASI.label, ref);
      IF ASS.IsInstr(sym) THEN Instruction
      ELSIF ASS.IsDirective(sym) THEN Directive
      ELSIF sym = ASS.ident THEN m := ASI.ThisMacro(ASS.id);
        IF m # NIL THEN MacroCall(m) END
      END
    END
  END Named;

  PROCEDURE Statement;
    VAR ref: ASI.Ref; m: ASI.Macro; name: ASS.Ident; errs, mnemonic: INTEGER;
  BEGIN
    IF sym = ASS.eol THEN Get
    ELSE errs := ASS.errcnt;
      IF ASS.IsInstr(sym) THEN  (*a mnemonic followed by "*" or ":" is a label*)
        mnemonic := sym - ASS.instr; ASH.Copy(ASS.id, name); Get;
        IF (sym = ASS.times) OR (sym = ASS.colon) THEN ref := ASI.NewRef(name); Named(ref)
        ELSE Operands(mnemonic)
        END
      ELSIF ASS.IsDirective(sym) THEN  (*so is a directive*)
        mnemonic := sym; ASH.Copy(ASS.id, name); Get;
        IF (sym = ASS.times) OR (sym = ASS.colon) THEN ref := ASI.NewRef(name); Named(ref)
        ELSE DirectiveRest(mnemonic)
        END
      ELSIF (sym = ASS.div) OR (sym = ASS.mod) THEN  (*and DIV or MOD*)
        ASH.Copy(ASS.id, name); Get;
        IF (sym = ASS.times) OR (sym = ASS.colon) THEN ref := ASI.NewRef(name); Named(ref)
        ELSE Unexpected
        END
      ELSIF sym = ASS.ident THEN m := ASI.ThisMacro(ASS.id);
        IF m # NIL THEN MacroCall(m)
        ELSE ref := ASI.NewRef(ASS.id); Get; Named(ref)
        END
      ELSIF sym = ASS.period THEN Get;
        IF ~IsName(TRUE) THEN ASS.Mark("identifier expected"); Skip
        ELSIF ASH.Same(ASS.id, "proc") THEN Get; Signature
        ELSIF ASH.Same(ASS.id, "type") THEN Get; TypeDeclaration
        ELSE ref := ASI.NewRef(ASS.id); ref.local := TRUE; Get; Named(ref)
        END
      ELSIF sym = ASS.var THEN Get; Definition(FALSE, FALSE)
      ELSIF sym = ASS.let THEN Get; Definition(TRUE, FALSE)
      ELSIF sym = ASS.if THEN IfStatement
      ELSIF sym = ASS.lbrace THEN ASI.BeginScope; Get;
        WHILE (sym # ASS.rbrace) & (sym # ASS.eot) & ~ended DO statement END;
        Check(ASS.rbrace, "} expected"); ASI.Put(ASI.scopeEnd)
      ELSIF sym = ASS.end THEN  (*ends the source, unless it is used as a name*)
        name := ASS.id; Get;
        IF (sym = ASS.eol) OR (sym = ASS.eot) THEN ended := TRUE
        ELSE ref := ASI.NewRef(name); Named(ref)
        END
      ELSIF (sym = ASS.while) OR (sym = ASS.repeat) OR (sym = ASS.for) OR (sym = ASS.until) THEN
        ASS.Mark("statement not implemented"); Skip
      ELSE Unexpected
      END;
      IF included THEN included := FALSE  (*sym begins the next statement*)
      ELSIF ~AtEnd() & ~ended THEN
        IF ASS.errcnt = errs THEN Unexpected ELSE Skip END   (*one message a statement*)
      END
    END
  END Statement;

  (* --- entry points --- *)

  (* Translate the source file `name`. *)
  PROCEDURE Compile*(name: ARRAY OF CHAR);
  BEGIN
    IF ~ASS.Open(name) THEN ASS.Error(NIL, 0, "cannot read ", name)
    ELSE ended := FALSE; included := FALSE; sym := 0; Get;
      WHILE (sym # ASS.eot) & ~ended DO
        IF sym = ASS.rbrace THEN ASS.Mark("unexpected }"); Get ELSE Statement END
      END
    END
  END Compile;

  (* Translate "name" or "name=expression" from the command line. *)
  PROCEDURE Define*(text: ARRAY OF CHAR);
  BEGIN ASS.OpenText(text); ended := FALSE; included := FALSE; sym := 0; Get;
    Definition(FALSE, TRUE);
    IF (sym # ASS.eol) & (sym # ASS.eot) THEN Unexpected END
  END Define;

  (* outName: the output file, beside which symbol files are sought. *)
  PROCEDURE Init*(out: ARRAY OF CHAR);
  BEGIN ASH.Copy(out, outName); ended := FALSE; included := FALSE; sym := 0
  END Init;

BEGIN expression := Expression; statement := Statement
END ASP.
