1029: 42 eb             	bsw
102b: 42 eb             	bsw a
102d: 42 c9 10 00       	div #$10		; at the start of a statement an instruction,
1031: 42 d5 10          .q:	div $10,x		; also after a label,
1034: a9 03 00          	lda #10 div 3		; but an operator in an expression
1037: 42 b1             	wdm #$B1
