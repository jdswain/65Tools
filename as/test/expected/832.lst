0000:                   ; 832.s - the 65C816X and the 65C832: the instructions after WDM, the
0000:                   ; widths of immediates, and where the new mnemonics are names
0000:                   	cpu = "65C816"
0000:                   	org = $1000
1000: 20 03 10          mul:	jsr udv			; names: the 65C816 has no such instructions
1003: 60                udv:	rts
1004:                   	cpu = "65C816X"		; from here on they are mnemonics
1004:                   	longa = on
1004:                   	longi = on
1004: 42 69 34 12       	mul #$1234
1008: 42 25 12          	uml $12
